# Absolute origin of the deployed site — used for metadataBase, sitemap.xml and robots.txt.
# Set it in Vercel → Project → Settings → Environment Variables (all environments) and
# redeploy; without it the sitemap lists localhost. Local builds fall back to localhost.
NEXT_PUBLIC_SITE_URL=https://filmaker-portafolio.vercel.app

# Set automatically by Vercel ("production" | "preview" | "development"). Do not set it
# by hand: src/lib/analytics.ts logs events to the console whenever it is not "production".
# NEXT_PUBLIC_VERCEL_ENV=
